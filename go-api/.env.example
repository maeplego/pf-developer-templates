# Process
HTTP_PORT=8080
DEV_AUTH=true
CORS_ORIGIN=http://localhost:3000

# P01 OIDC (required when DEV_AUTH is not true). Overlay sets issuer to the IdP.
# OIDC_ISSUER=http://localhost:8081
# OIDC_INTERNAL_BASE=http://identity:8081
# OIDC_AUDIENCE={{PROJECT}}

# P02 collector. Reserved even if this process does not export spans yet.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME={{PROJECT}}
